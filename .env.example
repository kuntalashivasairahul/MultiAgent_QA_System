# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Requests/sec. Free tier is ~30 req/min, so 0.4 rps (24/min) stays under.
GROQ_RPS=0.4

# LangSmith — free tier ~5k traces/month: https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multiagent-qa
