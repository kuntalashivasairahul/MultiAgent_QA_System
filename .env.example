# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=qwen/qwen3.8-27b
GROQ_MAX_RETRIES=8
# Requests/sec. NOTE: the real free-tier limit is 8000 TOKENS/min, which this
# cannot enforce — retries and per-model buckets do the actual work.
GROQ_RPS=0.25

# LangSmith — free tier ~5k traces/month: https://smith.langchain.com
# Opt in only after reviewing what prompts/documents may be sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multiagent-qa

# V3 candidate, not yet promoted: local Llama + Groq Judge; requires GROQ_API_KEY.
QA_BACKEND=lmstudio
QA_MODEL=llama-3.1-8b-instruct
QA_JUDGE_BACKEND=groq
QA_JUDGE_MODEL=qwen/qwen3.8-27b
QA_QUALITY_THRESHOLD=0.8
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Required for local evaluations, optional API provenance: SHA256 of the loaded GGUF.
# LMSTUDIO_MODEL_SHA256=
# For a different local Judge model, also set LMSTUDIO_JUDGE_MODEL_SHA256.
# Cloud alternative: QA_BACKEND=groq, QA_MODEL=openai/gpt-oss-120b,
# QA_JUDGE_MODEL=qwen/qwen3.8-27b. Verify any Groq Llama model ID before using it.
# Experimental fully local: QA_JUDGE_BACKEND=lmstudio and QA_JUDGE_MODEL=$QA_MODEL.
# The inspected 3B/8B self-Judges failed development controls; this is not the stable profile.
